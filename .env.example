# ==============================================================
# ExamVault Environment Configuration Template
# Duplicate this file to .env and configure secrets securely
# NEVER commit the actual .env file with real secrets to Git
# ==============================================================

# Flask Session Security Key (Generate a random 32+ character string)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration (Options: 'sqlite' or 'mysql')
DB_TYPE=mysql

# MySQL Connection Details
DB_HOST=db
DB_PORT=3306
DB_NAME=examvault
DB_USER=examvault_user
DB_PASSWORD=change_this_to_a_secure_mysql_password
MYSQL_ROOT_PASSWORD=change_this_to_a_secure_root_password

# Port configuration
PORT=5003
