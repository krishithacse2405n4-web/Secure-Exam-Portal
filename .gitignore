# ==============================================================
# ExamVault .gitignore
# Ensure no credentials, local databases, or temp files are committed
# ==============================================================

# Environment and Secrets
.env
.env.*
!.env.example
secrets/
*.pem
*.key
id_rsa*

# SQLite Database (Keep local development database private)
database/*.db
database/*.sqlite
database/*.sqlite3
*.db
*.sqlite

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing and Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE and Editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Ansible runtime files
ansible/*.retry
ansible/.vault_password*
